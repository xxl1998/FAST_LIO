<launch>
  <!-- ROS2 launch file for MaRSIM LiDAR -->

  <arg name="rviz" default="true"/>

  <node pkg="fast_lio" exec="fastlio_mapping" name="laserMapping" output="screen">
    <param name="config_file" value="marsim.yaml"/>
    <param name="runtime_pos_log_enable" value="false"/>
  </node>

  <node if="$(var rviz)"
        pkg="rviz2"
        exec="rviz2"
        name="rviz"
        output="screen"
        args="-d $(find-pkg-share fast_lio)/rviz/fastlio.rviz2"/>
</launch>
