<launch>
  <!-- ROS2 launch file for Livox MID360 LiDAR -->

  <arg name="rviz" default="true"/>

  <!-- <node pkg="tf2_ros"
        exec="static_transform_publisher"
        name="link1_broadcaster"
        args="0 0 0 0 0 0 map camera_init"/> -->

  <node pkg="fast_lio" exec="fastlio_mapping" name="laserMapping" output="screen"
  emulate_tty="true"
  >
    <param name="config_file" value="mid360.yaml"/>
    <param name="runtime_pos_log_enable" value="true"/>
    <remap from="/Odometry" to="/lidar_slam/odom"/>
  </node>

  <node if="$(var rviz)"
        pkg="rviz2"
        exec="rviz2"
        name="rviz"
        output="screen"
        args="-d $(find-pkg-share fast_lio)/rviz/fastlio.rviz2"/>
</launch>
