<launch>
  <!-- ROS2 launch file for velodyne16 VLP-16 LiDAR -->

  <node pkg="tf2_ros"
        exec="static_transform_publisher"
        name="link1_broadcaster"
        args="0 0 0 0 0 0 world camera_init"/>

  <arg name="rviz" default="true"/>

  <node pkg="fast_lio" exec="fastlio_mapping" name="laserMapping" output="screen">
    <param from="$(find-pkg-share fast_lio)/config/velodyne_gazebo.yaml"/>
    <param name="feature_extract_enable" value="false"/>
    <param name="point_filter_num" value="4"/>
    <param name="max_iteration" value="3"/>
    <param name="filter_size_surf" value="0.5"/>
    <param name="filter_size_map" value="0.5"/>
    <param name="cube_side_length" value="1000.0"/>
    <param name="runtime_pos_log_enable" value="true"/>
    <remap from="/Odometry" to="/lidar_slam/odom"/>
  </node>

  <node if="$(var rviz)"
        pkg="rviz2"
        exec="rviz2"
        name="rviz"
        output="screen"
        args="-d $(find-pkg-share fast_lio)/rviz/fastlio.rviz"/>
</launch>
