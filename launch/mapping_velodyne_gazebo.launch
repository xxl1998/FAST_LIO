<launch>
  <!-- Launch file for velodyne16 VLP-16 LiDAR -->
    <!-- Arguments: x y z yaw pitch roll parent_frame child_frame period_in_ms -->
    <node pkg="tf" type="static_transform_publisher" name="link1_broadcaster" args="0 0 0 0 0 0 1 world camera_init 100" />

    <arg name="rviz" default="true" />

    <param name="config_file" value="velodyne_gazebo.yaml" type="string"></param>

    <param name="runtime_pos_log_enable" type="bool" value="1" />
    <node pkg="fast_lio" type="fastlio_mapping" name="laserMapping" output="screen" > 
    <remap from="/Odometry" to="/lidar_slam/odom"/>
    </node>

    <group if="$(arg rviz)">
    <node launch-prefix="nice" pkg="rviz" type="rviz" name="rviz" args="-d $(find fast_lio)/rviz/fastlio.rviz" />
    </group>

</launch>
